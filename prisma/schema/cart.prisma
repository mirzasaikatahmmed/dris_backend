model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @db.Uuid
  restaurantId String     @db.Uuid
  status       CartStatus @default(ACTIVE)

  totalAmount Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User?      @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  items CartItem[]
  order Order?

  @@index([userId])
  @@index([restaurantId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @db.Uuid
  productId String  @db.Uuid
  variantId String? @db.Uuid

  quantity Int @default(1)

  // base variant price (or product base price if no variant)
  unitPrice Decimal @db.Decimal(10, 2)

  // includes extras * quantity (store final line total for speed)
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  options CartItemOption[]

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model CartItemOption {
  id         String @id @default(uuid()) @db.Uuid
  cartItemId String @db.Uuid

  groupId String @db.Uuid
  itemId  String @db.Uuid // references ModifierOption.id

  quantity  Int     @default(1)
  unitPrice Decimal @default(0) @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  cartItem CartItem @relation(fields: [cartItemId], references: [id])

  // FIXED: real relations (with explicit names to avoid ambiguity)
  group ModifierGroup  @relation("GroupToCartSelections", fields: [groupId], references: [id])
  item  ModifierOption @relation("OptionToCartSelections", fields: [itemId], references: [id])

  @@index([cartItemId])
  @@index([groupId])
  @@index([itemId])
  @@map("cart_item_options")
}

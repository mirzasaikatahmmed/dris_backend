model ModifierGroup {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid

  name       String  @db.VarChar(120) // "Add Extras"
  isRequired Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(0)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  externalId String?  @db.VarChar(100)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  options ModifierOption[] @relation("GroupToOptions")

  // many products <-> many groups
  products ProductModifierGroup[]

  // selections from cart/order
  cartSelections  CartItemOption[]  @relation("GroupToCartSelections")
  orderSelections OrderItemOption[] @relation("GroupToOrderSelections")

  @@index([restaurantId])
  @@map("modifier_groups")
}

model ModifierOption {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid

  name  String  @db.VarChar(120) // "Extra Bacon"
  price Decimal @default(0) @db.Decimal(10, 2)

  externalId   String? @db.VarChar(100)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group ModifierGroup @relation("GroupToOptions", fields: [groupId], references: [id])

  // selections from cart/order
  cartSelections  CartItemOption[]  @relation("OptionToCartSelections")
  orderSelections OrderItemOption[] @relation("OptionToOrderSelections")

  @@index([groupId])
  @@map("modifier_options")
}

// Attach groups to products (M:N)
model ProductModifierGroup {
  productId String @db.Uuid
  groupId   String @db.Uuid

  product Product       @relation(fields: [productId], references: [id])
  group   ModifierGroup @relation(fields: [groupId], references: [id])

  @@id([productId, groupId])
  @@index([groupId])
  @@map("product_modifier_groups")
}
